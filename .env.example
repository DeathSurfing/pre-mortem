# ---- primary LLM: OpenCode Go (OpenAI-compatible) ----
# chat REQUIRES the x-opencode-session header; JSON mode and auto/forced tool calling all verified working
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_SESSION=pre-mortem-prod
LLM_MODEL=deepseek-v4.1-flash
HINDSIGHT_LLM_MODEL=deepseek-v4-flash
HINDSIGHT_LLM_EXTRA_HEADERS={"x-opencode-session": "pre-mortem-prod"}

# ---- fallback LLM: 9Router (verified working) ----
# never use kimchi/* (402 out of credits) or openrouter/* (403 key limit)
NINEROUTER_URL=https://9router.lexcontra.com
NINEROUTER_API_KEY=
LLM_FALLBACK_MODEL=gareebi

# ---- Hindsight (self-hosted FOSS; Cloud pins the model) ----
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_BANK_ID=premortem

# ---- web <-> api ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# deployed: https://premortem-api.lexcontra.com

# ---- ranking ----
MIN_PROOF=1

# ---- prompt store (postgres + pgvector) ----
# Every prompt run is recorded and vectorised here, for cross-referencing across prompts. Prompts are
# deliberately NOT retained in Hindsight: a typed prompt is not company knowledge until a person commits
# it, which is what the "commit to knowledge base" action does.
# Locally, point at a postgres with the pgvector extension; in compose this is the `postgres` service.
PROMPT_DB_URL=postgresql://premortem:premortem@localhost:5432/premortem
POSTGRES_USER=premortem
POSTGRES_PASSWORD=premortem
POSTGRES_DB=premortem
# Local CPU embedder, reuses the torch already in the image for Laya. 384-dim, so changing the model
# requires a matching vector(384) column.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Cosine similarity below which a match is labelled weak rather than presented as a precedent.
PROMPT_SIM_CUTOFF=0.35

# ---- abuse guards ----
# One switch for the whole guard surface:
#   prod (default) -> admin endpoints disabled (404), per-visitor rate limit ON
#   dev            -> both guards OFF, so development is not spent fighting them
# An unset or unrecognised APP_MODE is treated as prod, so a typo tightens rather than opens.
APP_MODE=prod
# Per-guard overrides, for when the mode is not the answer. Leave unset normally; these win over APP_MODE.
ADMIN_ENDPOINTS_ENABLED=
RATE_LIMIT_ENABLED=
# Per-visitor cap on the counted endpoints (see README: Production guards). 10 per 24h by default.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=86400
# Shown on the contact gate once the allowance is spent.
CONTACT_SALES_URL=mailto:adityavikram@lexcontra.com
# CORS: the web origin only, never `*`. In compose this is set in the Dokploy panel.
CORS_ORIGINS=https://premortem.lexcontra.com
