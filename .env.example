# 9Router (LLM gateway) — same key drives our app and Hindsight
NINEROUTER_URL=https://9router.lexcontra.com
NINEROUTER_API_KEY=

# models (verified working: gareebi, ocg/deepseek-v4.1-flash)
# do NOT use kimchi/* (402 out of credits) or openrouter/* (403 key limit) lanes
LLM_MODEL=gareebi
LLM_FALLBACK_MODEL=ocg/deepseek-v4.1-flash
HINDSIGHT_LLM_MODEL=gareebi

# Hindsight (self-hosted; FOSS image pins nothing, unlike Cloud)
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_BANK_ID=premortem

# FastAPI <-> Next.js
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ranking
MIN_PROOF=1
